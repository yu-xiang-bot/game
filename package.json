    "@typescript-eslint/eslint-plugin": "5.33.1",
    "@typescript-eslint/parser": "5.33.1",
    "@zip.js/zip.js": "2.4.10",
    "eslint": "8.22.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-standard": "17.0.0",
    "eslint-webpack-plugin": "3.2.0",
    "intersects": "2.7.2",
    "jquery": "3.6.0",
    "lodash": "4.17.20",
    "pixi-filters": "^4.2.0",
