{
  "name": "block-transmission",
  "version": "1.0.0",
  "description": "星云守护 - 一个用pixi.js编写的h5塔防游戏",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rimraf dist&&webpack --mode=production --node-env=production&&node build/build.js",
    "build:vercel": "rimraf dist&&webpack --mode=production --node-env=production&&node vercel-build.js",
    "build:dev": "webpack --mode=development",
    "build:prod": "webpack --mode=production --node-env=production",
    "build:devplist": "rimraf dist&&webpack --mode=production --node-env=production --config ./webpack.config.plist.js&&node build/build.js",
    "build:devtiled": "rimraf dist&&webpack --mode=production --node-env=production --config ./webpack.config.tiled.js&&node build/build.js",
    "watch": "webpack --watch",
    "serve": "webpack serve --mode=development",
    "devgen": "webpack-dev-server --config ./webpack.config.gen.js",
    "devplist": "webpack-dev-server --config ./webpack.config.plist.js",
    "devtiled": "webpack-dev-server --config ./webpack.config.tiled.js",
    "dev": "npm run serve",
    "doc": "node build/docs.js&&typedoc"
  },
  "author": "1829738634@qq.com",
  "license": "ISC",
